# Never commit OAuth secrets
Automation/credentials.json
Automation/token.json

# Local-only config (Drive file IDs etc.) — example is committed
Automation/local_config.json

# Logs
Automation/*.log
Automation/launchd.*.log

# Quarter Target comes from Google Drive on each run, never the repo
Data/Input/Quarter Target.xlsx

# The Gmail-downloaded CSVs are regenerated every run — don't pollute history
Data/Input/Incoming_Order_Count_Insurer_Wise.csv
Data/Input/Revenue_Generated_Insurer_Wise.csv
Data/Input/Closed_Case_Count_Insurer_Wise.csv

# OS junk
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor folders
.vscode/
.idea/

# Cloudflare wrangler local cache (auth tokens, build artefacts)
cloudflare-worker/.wrangler/
**/.wrangler/

# Don't accidentally commit a nested clone
cardiotrack-dashboard/
